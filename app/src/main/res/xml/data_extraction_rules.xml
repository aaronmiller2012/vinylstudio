<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+). Cloud backup stays disabled: photos and projects never leave
  the device without an explicit user export. Device-to-device transfer (cable or
  local Wi-Fi during new-phone setup) carries the user's saved work so upgrading a
  phone no longer silently erases the project library. The in-progress editor state,
  staging files, caches and crash diagnostics are intentionally not transferred.
-->
<data-extraction-rules xmlns:android="http://schemas.android.com/apk/res/android">
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="project-library/" />
        <include domain="sharedpref" path="vinylstudio-palettes.xml" />
        <include domain="sharedpref" path="scrap_calibration_v1.xml" />
        <include domain="sharedpref" path="style_discovery_v1.xml" />
    </device-transfer>
</data-extraction-rules>
